{
  "name": "tsinghua-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "清华生存指南 —— 学长学姐的经验指导站",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "tsx scripts/check-content.ts",
    "check:content:strict": "tsx scripts/check-content.ts --strict",
    "check:links": "tsx scripts/check-links.ts",
    "check:e2e": "node scripts/e2e-smoke.mjs",
    "measure:perf": "node scripts/measure-perf.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:assets": "node scripts/check-assets.mjs --dist",
    "check:feeds": "node scripts/check-feeds.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:media:dist": "node scripts/check-media.mjs --dist",
    "review:links": "tsx scripts/review-links.ts",
    "review:links:apply": "tsx scripts/review-links.ts --apply",
    "verify:links": "tsx scripts/verify-links.ts",
    "check:all": "npm run check && npm run check:content && npm run check:admin && npm run check:media",
    "verify": "npm run check:all && npm run build && npm run check:jsonld && npm run check:assets && npm run check:feeds && npm run check:media:dist",
    "courses": "node scripts/build-course-index.mjs",
    "courses:check": "node scripts/build-course-index.mjs --check",
    "og": "tsx scripts/generate-og.mjs",
    "admin:vendor": "node scripts/vendor-admin.mjs",
    "r2:setup": "node scripts/r2-setup.mjs",
    "auth:deploy": "wrangler deploy --config auth-worker/wrangler.jsonc",
    "auth:dry": "wrangler deploy --dry-run --config auth-worker/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@sveltia/cms": "^0.225.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.144.0",
    "yaml": "^2.9.1"
  }
}
