---
/**
 * 课程资料索引页（不走 Starlight 的文档路由，因为要渲染一个自有的筛选界面）。
 *
 * 数据来自 src/data/course-index.json —— 由脚本从几个公开资料库扫出来，
 * 本站只做索引，不镜像任何课程文件。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CourseExplorer from '../../components/CourseExplorer.astro';
import { archives, archiveOrder, courseIndexSummary } from '../../data/courses';

const stats = courseIndexSummary();

/** 可达性角标：用 ASCII 类名，避免中文类名在压缩/工具链里出意外 */
const REACH_CLASS: Record<string, string> = {
  校园网: 'campus',
  公网: 'public',
  需代理: 'proxy',
  未实测: 'unknown',
};
const reachClass = (reach: string) => REACH_CLASS[reach] ?? 'unknown';
---

<StarlightPage
  frontmatter={{
    title: '课程资料索引',
    description:
      '哪门课、在哪个公开资料库里有材料、是往年题还是笔记——一份不镜像文件的课程资料索引，含校内可达性与使用边界。',
    tableOfContents: false,
  }}
>
  <p>
    想找某门课的往年题、笔记或作业答案，通常要在四五个资料库之间来回翻。这一页把它们的目录<strong>扫成了一张表</strong>：
    <strong>一共 {stats.courses} 门课、{stats.sources} 条资料</strong>，
    出自 {archiveOrder.length} 个公开资料库，其中 {stats.withBooks} 门课还带参考书目。
  </p>

  <div class="stats">
    <div class="stats__item">
      <span class="stats__num">{stats.courses}</span>
      <span class="stats__label">门课</span>
    </div>
    <div class="stats__item">
      <span class="stats__num">{stats.sources}</span>
      <span class="stats__label">条资料</span>
    </div>
    <div class="stats__item">
      <span class="stats__num">{stats.withBooks}</span>
      <span class="stats__label">门带参考书目</span>
    </div>
    <div class="stats__item">
      <span class="stats__num">{archiveOrder.length}</span>
      <span class="stats__label">个资料库</span>
    </div>
  </div>

  <aside class="callout">
    <p>
      <strong>本站不存放任何课程文件。</strong>这里只记录「某个资料库里有这门课的材料」，链接直接指向原资料库。
      文件版权与许可归各自作者，请按原库的说明使用。
    </p>
    <p>
      另外一个必须说清的事：<strong>资料不是答案，往年题不是考纲。</strong>
      资料库自己都写着「别再背 repo 里的东西了」。它们用来复习、对照思路、查漏补缺；
      用来交作业就是学术不端，用来押题通常会失望。边界见
      <a href="/academics/academic-integrity/">作业、引用与 AI</a>。
    </p>
  </aside>

  <h2>每个资料库是什么来头</h2>
  <div class="archives">
    {archiveOrder.map((id) => {
      const archive = archives[id];
      return (
        <article class="archive">
          <h3>{archive.short}</h3>
          <p class="archive__org">
            {archive.org} · 收录 {stats.perArchive[id]} 门课
          </p>
          <p>{archive.desc}</p>
          <p class="archive__strength">
            <strong>强项：</strong>
            {archive.strength}
          </p>
          <p class="archive__caution">
            <strong>注意：</strong>
            {archive.caution}
          </p>
          <p class="archive__license">许可：{archive.license}</p>
          <ul class="archive__links">
            {archive.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
                <span class={`reach reach--${reachClass(link.reach)}`}>{link.reach}</span>
                {link.note && <span class="archive__note">{link.note}</span>}
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>

  <h2>怎么用这张表</h2>
  <ol>
    <li>
      <strong>先看「资料类型」，再看课程名。</strong>
      想知道考试怎么考，就筛「往年题」；想补基础，就筛「笔记」「课件」。
    </li>
    <li>
      <strong>注意「可达性」角标。</strong>
      <span class="reach reach--campus">校园网</span> 表示要连校园网；
      <span class="reach reach--proxy">需代理</span> 表示这个域名在校园网内打不开（实测结论）；
      <span class="reach reach--unknown">未实测</span> 表示我们还没在校园网里验过，别当保证。
    </li>
    <li>
      <strong>同一门课在不同库里各有侧重。</strong>
      计算机系课程攻略偏往年题与考试资料，未央学习偏作业答案，ReadMe 偏复习提纲与作业思路，
      技能引导文档解决的是「上这门课需要会什么工具」。
    </li>
    <li>
      <strong>资料会过期。</strong>
      课程大纲、教材、考核方式每隔几年会变，资料库里的东西反映的是当时那一届。
      以当年开课信息为准 —— 这一点没有例外。
    </li>
  </ol>

  <CourseExplorer />

  <h2>这一页的数据是怎么来的</h2>
  <p>
    数据由脚本从四个公开资料库的目录结构里扫出来，不是人肉抄的，也不是猜的。
    想知道某个库具体收了什么、怎么克隆到本地，见
    <a href="/guides/archives/">外部资料库地图</a>。
  </p>

  <p class="footer-links">
    相关页面：<a href="/guides/archives/">外部资料库地图</a> ·
    <a href="/academics/course-types/">各类课程怎么选</a> ·
    <a href="/academics/course-selection/">培养方案与选课</a> ·
    <a href="/academics/academic-integrity/">学术规范的边界</a> ·
    <a href="/contribute/">怎么贡献</a>
  </p>
</StarlightPage>

<!-- JSON-LD 由 src/components/Head.astro 统一输出（避免同页出现两个互相矛盾的 @type） -->

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 2rem;
  }

  .stats__item {
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.5rem;
    text-align: center;
  }

  .stats__num {
    display: block;
    font-size: var(--sl-text-h3);
    font-weight: 700;
    color: var(--sl-color-accent-high);
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .callout {
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--sl-color-accent);
    background: var(--sl-color-gray-7, transparent);
    border-radius: 0 0.4rem 0.4rem 0;
    font-size: var(--sl-text-sm);
  }

  .callout p {
    margin: 0.4rem 0;
  }

  .archives {
    display: grid;
    gap: 0.9rem;
    margin: 1rem 0 2rem;
  }

  .archive {
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.5rem;
  }

  .archive h3 {
    margin: 0 0 0.2rem;
    font-size: var(--sl-text-h5);
  }

  .archive p {
    margin: 0.35rem 0;
    font-size: var(--sl-text-sm);
    line-height: 1.7;
  }

  .archive__org,
  .archive__license,
  .archive__note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .archive__links {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: var(--sl-text-sm);
  }

  .archive__links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .reach {
    font-size: var(--sl-text-xs);
    border-radius: 0.3rem;
    padding: 0 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .reach--campus {
    color: hsl(150, 60%, 70%);
    border-color: hsl(150, 40%, 35%);
  }

  .reach--public {
    color: hsl(210, 60%, 72%);
    border-color: hsl(210, 40%, 40%);
  }

  .reach--proxy {
    color: hsl(35, 80%, 70%);
    border-color: hsl(35, 50%, 40%);
  }

  :global(:root[data-theme='light']) .reach--campus {
    color: hsl(155, 70%, 25%);
    border-color: hsl(155, 40%, 60%);
  }

  :global(:root[data-theme='light']) .reach--public {
    color: hsl(212, 70%, 32%);
    border-color: hsl(212, 40%, 62%);
  }

  :global(:root[data-theme='light']) .reach--proxy {
    color: hsl(28, 80%, 32%);
    border-color: hsl(28, 50%, 60%);
  }

  .footer-links {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
